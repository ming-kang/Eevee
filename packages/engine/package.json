{
  "name": "@eevee/engine",
  "version": "0.0.1",
  "private": true,
  "description": "Local Eevee daemon: multi-project hosting, shared MCP hub, auth/models store, and HTTP/SSE API.",
  "type": "module",
  "exports": {
    ".": {
      "eevee-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "node ../../scripts/test.ts packages/engine"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-mcp": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "@eevee/agent": "0.0.1",
    "@eevee/core": "0.0.1",
    "@eevee/memory": "0.0.1",
    "@eevee/protocol": "0.0.1"
  }
}
