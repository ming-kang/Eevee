{
  "name": "@astralyn/eevee",
  "version": "0.0.1",
  "private": true,
  "description": "A proactive agent: one Router you talk to, tickets executed in the background, and a Git-backed memory.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "eevee": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "node src/cli/index.ts",
    "dev:scenario": "node scripts/dev-scenario.ts",
    "engine": "node src/daemon/main.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && vue-tsc -p web/tsconfig.json && tsc -p web/tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@hono/node-server": "2.1.6",
    "commander": "15.1.0",
    "diff": "8.0.4",
    "hono": "4.13.14",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@remixicon/vue": "4.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "6.0.11",
    "reka-ui": "2.11.0",
    "shiki": "4.6.0",
    "stream-markdown-parser": "1.2.27",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
